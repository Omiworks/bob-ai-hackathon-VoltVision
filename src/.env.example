# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore
#
# GridGuardian AI environment variables.
# The real per-service example lives at src/backend/.env.example.

# LLM integration (used only by the AI Operations Brief)
# GridGuardian degrades gracefully without this key: every numeric page
# (dashboard, assets, simulation, priority) works fully without it.
ANTHROPIC_API_KEY=

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:5173