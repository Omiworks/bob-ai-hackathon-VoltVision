# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- LLM integration (used from Phase 8 onward) ---
# GridGuardian degrades gracefully without this key: numeric pages (dashboard,
# asset analysis, simulation, maintenance priority) work fully without it.
# Only the AI Operations Brief / Copilot pages require it.
ANTHROPIC_API_KEY=

# --- App config ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
